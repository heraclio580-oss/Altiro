{
  "name": "altiro",
  "version": "0.1.0",
  "private": true,
  "description": "Altiro fitness training app - standalone web app + native (iOS/Android) shell",
  "scripts": {
    "dev": "npx serve www -l 5173",
    "test": "node tests/run-all.js",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync && node scripts/native-config.js",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "vendor": "cp node_modules/@supabase/supabase-js/dist/umd/supabase.js www/vendor/supabase.js",
    "native-config": "node scripts/native-config.js",
    "assets": "capacitor-assets generate --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#0a0a0a' --splashBackgroundColorDark '#0a0a0a'",
    "store-screenshots": "node scripts/store-screenshots/demo-data.js && node scripts/store-screenshots/capture.js && LANG_CODE=es node scripts/store-screenshots/capture.js && node scripts/store-screenshots/compose.js"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "jsdom": "^30.1.0"
  }
}
